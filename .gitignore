# macOS
.DS_Store

# Xcode per-user state: scheme ordering, window layout, breakpoints.
# Specific to one machine and wrong to share.
xcuserdata/
*.xcuserstate
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# Build products and code coverage emitted by `xcodebuild test`
build/
DerivedData/
*.profraw
*.profdata
Archives/

# The local zvec-grep workspace index
.zvec-grep/

# Node, for the browser extension in bridge/. `package-lock.json` is deliberately
# not ignored: the extension has no dependencies at runtime and the lock file is
# what makes the jsdom test dependency auditable.
bridge/node_modules/

# The assembled extension. Generated by `node bridge/build.mjs` from
# bridge/src and bridge/extension; committed nowhere, because a checked-in
# bundle is a second copy of the source that nobody edits and everybody has to
# remember to rebuild. The manifest points at it, so it must be built before
# loading the extension -- `scripts/test.sh` does that on every run.
bridge/extension/lib/
